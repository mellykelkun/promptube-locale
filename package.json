{
  "name": "promptube-admin-locale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "./tests/scripts/docker-scripts.test.sh",
    "test:operations": "node tests/operations/operations.mjs",
    "test:integration": "./scripts/test-auth-all.sh integration",
    "test:e2e": "./scripts/test-auth-all.sh e2e",
    "test:auth": "./scripts/test-auth-all.sh auth",
    "test:auth:security": "./scripts/test-auth-all.sh security",
    "test:auth:all": "./scripts/test-auth-all.sh all",
    "test:catalog": "./scripts/test-catalog-all.sh all",
    "test:catalog:integration": "./scripts/test-catalog-all.sh integration",
    "test:catalog:e2e": "./scripts/test-catalog-all.sh e2e",
    "test:catalog:security": "./scripts/test-catalog-all.sh security",
    "test:catalog:all": "./scripts/test-catalog-all.sh all",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write \"*.{json,md,mjs,ts,yaml,yml}\" \"compose*.yaml\" \"docs/**/*.md\" \"private-modules/**/*.md\" \"scripts/**/*.{js,mjs,ts}\" \"secrets/*.md\" \"src/**/*.{css,ts,tsx,md}\" \"tests/**/*.{mjs,ts,tsx}\"",
    "format:check": "prettier --check \"*.{json,md,mjs,ts,yaml,yml}\" \"compose*.yaml\" \"docs/**/*.md\" \"private-modules/**/*.md\" \"scripts/**/*.{js,mjs,ts}\" \"secrets/*.md\" \"src/**/*.{css,ts,tsx,md}\" \"tests/**/*.{mjs,ts,tsx}\"",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:scripts && npm run build",
    "modules:manifest": "NODE_OPTIONS=--conditions=react-server tsx scripts/modules/module-packages-cli.ts manifest",
    "modules:validate": "NODE_OPTIONS=--conditions=react-server tsx scripts/modules/module-packages-cli.ts validate",
    "modules:build": "NODE_OPTIONS=--conditions=react-server tsx scripts/modules/module-packages-cli.ts build",
    "modules:build:all": "NODE_OPTIONS=--conditions=react-server tsx scripts/modules/module-packages-cli.ts build:all",
    "modules:check": "NODE_OPTIONS=--conditions=react-server tsx scripts/modules/module-packages-cli.ts check",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "db:generate": "drizzle-kit generate",
    "db:check": "node scripts/db/check.mjs",
    "db:provision": "COMPOSE_PROFILES=tools ./scripts/docker-compose.sh run --rm admin-promptube-db-provision",
    "db:migrate": "COMPOSE_PROFILES=tools ./scripts/docker-compose.sh run --rm admin-promptube-db-migrate",
    "db:status": "COMPOSE_PROFILES=tools ./scripts/docker-compose.sh run --rm admin-promptube-db-migrate node scripts/db/status.mjs",
    "db:backup": "npm run backup:create",
    "db:restore:test": "npm run backup:restore:test",
    "admin:bootstrap": "COMPOSE_PROFILES=tools ./scripts/docker-compose.sh run --rm -it admin-promptube-admin-bootstrap",
    "admin:sessions:revoke-all": "COMPOSE_PROFILES=tools ./scripts/docker-compose.sh run --rm admin-promptube-admin-sessions-revoke-all",
    "ops:status": "node scripts/ops/status.mjs",
    "backup:create": "node scripts/ops/backup-create.mjs",
    "backup:list": "node scripts/ops/backup-list.mjs",
    "backup:verify": "node scripts/ops/backup-verify.mjs",
    "backup:restore:test": "node scripts/ops/backup-restore-test.mjs",
    "backup:retention:dry-run": "node scripts/ops/retention.mjs dry-run",
    "backup:retention:apply": "node scripts/ops/retention.mjs apply",
    "secrets:rotation:check": "node scripts/ops/rotation-check.mjs",
    "secrets:rotation:test": "node scripts/ops/rotation-test.mjs",
    "disaster-recovery:test": "node scripts/ops/disaster-recovery-test.mjs",
    "docker:secrets:init": "./scripts/init-docker-secrets.sh",
    "docker:config": "./scripts/docker-compose.sh config",
    "docker:build": "./scripts/docker-compose.sh build",
    "docker:up": "./scripts/docker-compose.sh up -d --wait --wait-timeout 180",
    "docker:up:storage": "COMPOSE_PROFILES=storage ./scripts/docker-compose.sh up -d --wait --wait-timeout 180",
    "docker:ps": "./scripts/docker-compose.sh ps",
    "docker:logs": "./scripts/docker-compose.sh logs --no-color --tail 200",
    "docker:health": "./scripts/docker-health.sh",
    "docker:verify": "./scripts/verify-docker-stack.sh",
    "docker:verify:storage": "EXPECT_STORAGE=1 ./scripts/verify-docker-stack.sh",
    "docker:test:config": "./scripts/test-auth-all.sh config",
    "docker:test:up": "./scripts/test-auth-all.sh up",
    "docker:test:down": "./scripts/test-auth-all.sh down",
    "docker:down": "./scripts/docker-compose.sh down"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.6.25",
    "@node-rs/argon2": "2.0.2",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "better-auth": "1.6.25",
    "drizzle-orm": "0.45.2",
    "ipaddr.js": "2.4.0",
    "next": "16.2.12",
    "pg": "8.22.0",
    "qrcode": "1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "redis": "6.1.0",
    "rehype-sanitize": "6.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "server-only": "^0.0.1",
    "unified": "11.0.5",
    "yauzl": "3.4.0",
    "yazl": "3.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
