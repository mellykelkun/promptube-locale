{
  "name": "promptube-admin-locale",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:scripts": "./tests/scripts/docker-scripts.test.sh",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run test:scripts && npm run build",
    "audit": "npm audit",
    "audit:prod": "npm audit --omit=dev",
    "docker:secrets:init": "./scripts/init-docker-secrets.sh",
    "docker:config": "./scripts/docker-compose.sh config",
    "docker:build": "./scripts/docker-compose.sh build",
    "docker:up": "./scripts/docker-compose.sh up -d --wait --wait-timeout 180",
    "docker:ps": "./scripts/docker-compose.sh ps",
    "docker:logs": "./scripts/docker-compose.sh logs --no-color --tail 200",
    "docker:health": "./scripts/docker-health.sh",
    "docker:verify": "./scripts/verify-docker-stack.sh",
    "docker:down": "./scripts/docker-compose.sh down"
  },
  "dependencies": {
    "next": "16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^30.0.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
