# Public host binding for the reverse proxy only.
ADMIN_HTTP_PORT=8080

# Non-sensitive application metadata.
APP_ENV=local
APP_VERSION=0.1.0
NEXT_PUBLIC_APP_NAME="Promptube Admin"
BETTER_AUTH_BASE_URL=http://127.0.0.1:8080
TRUSTED_ORIGINS=http://127.0.0.1:8080

# Local administration database identifiers.
POSTGRES_DB=promptube_admin
POSTGRES_USER=promptube_admin
POSTGRES_APP_USER=promptube_admin_app
POSTGRES_MIGRATION_USER=promptube_admin_migration
POSTGRES_BACKUP_USER=promptube_admin_backup

# Non-sensitive object-storage root identifier.
MINIO_ROOT_USER=promptube_admin_storage
